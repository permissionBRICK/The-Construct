#!/usr/bin/env bash
# construct — agent-facing CLI for managing project profiles on the VM.
#
# Usage:
#   construct project set <name> [--file <path>]   write/update a profile
#   construct project delete <name>               delete a profile on the next sync
#   construct project get <name>                   print a stored profile
#   construct project list                         list stored profile names
#   construct project conflicts [--fetch]          open profile conflicts (host service only)
#   construct project resolve <id> [--file <path>] resolve one (host service only)
#   construct notify <message> [--title …]         desktop notification on the host
#   construct expose <port> [--label …]            port forward + the link to open
#   construct vm <command> [args]                    manage delegated child VMs
#   construct secret <command> [args]              key vault: lease secrets the user approves
#   construct backup <command> [args]              encrypted config backups stored by the host
#   construct config get|set|unset|list [args]     per-VM settings agents may change
#   construct update status|run [--json]           a newer Construct for this VM; update it
#   construct systemprompt                         regenerate every agent's instruction
#                                                  file (template + ~/construct-custom-system-prompt.md)
#
# The canonical store is /opt/construct/projects (overridable via PROJECTS_STORE).
# Changes sync to the host and survive VM reinstall; anything NOT recorded in a
# profile here is lost on reinstall.
# Missing files are restored from the host; use project delete to remove a profile.
#
# Exit codes:
#   0  success
#   1  not found (get) / general error
#   2  validation error (set)
#   3  reserved name (set/delete)
#   4  node not available (set requires node for schema validation)
#   6  project: the edit is in conflict with a change made elsewhere (host service)
#   5  notification queue full (notify)
#   6  expose: no Construct client attached (the request stays queued)
#   7  expose: refused by the host service (host forwards disabled, cap reached)
#   8  expose: the host service could not be reached
#   6  secret: no Construct Companion picked the request up (on a host
#      service: the host service could not be reached)
#   7  secret: denied by the user, or no answer in time
#   8  secret: the Companion (or the host service) reported an error
#   9  secret: no such secret
#  10  secret: a secret with that name already exists
#  11  secret: the vault is locked for this VM (start or connect it from the
#      user's PC)
#   2  config: unknown key or invalid value
#   backup: 2 usage, 3 no recipients enrolled, 4 no host service or the host
#      lacks the feature, 5 not enough space on the VM, 6 host refused,
#      7 transfer failed, 8 decryption or verification failed, 9 another
#      backup or restore is running, 10 export or restore step failed
#   update: 4 no engine or an older host without the route, 6 refused by
#      the engine, 8 the engine could not be reached
set -euo pipefail

PROJECTS_STORE="${PROJECTS_STORE:-/opt/construct/projects}"
CONSTRUCT_REPO_DIR="${CONSTRUCT_REPO_DIR:-/opt/construct/repo}"

usage() {
  cat <<'USAGE'
Usage: construct project <command> [args]
       construct notify <message> [options]
       construct update status|run [--json]
       construct systemprompt

update — a newer Construct for this VM, through its engine:
  status [--json]               Whether a newer payload or host release is out.
  run [--json]                  Update this VM (and the host first, when you
                                administer it and a host release is out).
  See construct update --help.

systemprompt — regenerate the global instruction file of every installed agent
  (~/.claude/CLAUDE.md, ~/.codex/AGENTS.md, ~/.config/opencode/AGENTS.md) from
  Construct's template plus ~/construct-custom-system-prompt.md. Those files are
  managed: put machine-wide rules in the custom file, then run this.

Project commands:
  set  <name> [--file <path>]   Create or update a project profile.
                                Reads JSON from --file or stdin.
  get  <name>                   Print the stored profile to stdout.
  delete <name>                 Remove a profile from the VM and host on next sync.
  list                          List stored profile names.
  conflicts [--fetch]           Open conflicts between this VM's profile edits and
                                changes made elsewhere (VMs with a host service);
                                --fetch writes base, ours and theirs to files.
  resolve <id> [--file <path>]  Send the resolved profile for a conflict.

notify — raise a desktop notification on the Windows host:
  -t, --title <text>            Headline (default: the VM's hostname)
  -l, --level info|warning|error
                                Severity (default: info). warning/error stay on
                                screen longer.
  Reads the message from the arguments, or from stdin when given "-".
  One-way by design: it cannot ask the user anything and returns no answer —
  put questions in your own chat with the user instead.

Environment:
  PROJECTS_STORE    Profile directory (default: /opt/construct/projects)
  NOTIFY_SPOOL      Notification spool (default: /run/construct/notify)
USAGE
}

die() { printf '%s\n' "$*" >&2; exit 1; }

# Locate a helper script shipped alongside this CLI: /usr/local/bin on a
# provisioned VM, bin/ in a dev checkout, with the canonical repo path as the
# fallback (the same lookup `project set` does for project-set.js).
find_helper() {
  local name="$1" dir candidate
  dir="$(cd "$(dirname "$0")" && pwd)"
  for candidate in "${dir}/${name}" "${CONSTRUCT_REPO_DIR}/bin/${name}"; do
    if [[ -f "${candidate}" ]]; then printf '%s' "${candidate}"; return 0; fi
  done
  return 1
}

# Reject filename-unsafe profile names before they are concatenated into a store
# path (mirrors the JS validateProfile / host safeProfileName guard): a name must
# be a single path component — no separators, no "..", not "."/"..", no control
# characters, non-empty. Prevents `get ../secret` escaping ${PROJECTS_STORE}.
is_safe_name() {
  local n="$1"
  [[ -n "$n" ]] || return 1
  [[ "$n" != "." && "$n" != ".." ]] || return 1
  case "$n" in
    */*|*'\'*|*'..'*) return 1 ;;
  esac
  [[ "$n" == *[[:cntrl:]]* ]] && return 1
  return 0
}

# -- notify --------------------------------------------------------------------
# Queue a desktop notification for the Windows host. This writes ONE single-line
# JSON file into a spool dir; the host's VS Code extension claims it over SSH
# (atomic rename, so multiple VS Code windows show it once) and raises a real
# Windows toast. The spool lives on tmpfs so a reboot can't replay old messages.
#
# One-way on purpose: there is no reply channel and no exit status carrying an
# answer. An agent that needs a decision should ask in its own chat with the user.

NOTIFY_SPOOL="${NOTIFY_SPOOL:-/run/construct/notify}"
# Flood guard: a looping agent must not be able to bury the host in popups (or
# fill tmpfs) while VS Code is closed and nothing is draining the spool.
NOTIFY_MAX_PENDING="${NOTIFY_MAX_PENDING:-50}"
NOTIFY_MAX_TITLE=100
NOTIFY_MAX_BODY=400

# Strip control characters -- they would break the host's one-entry-per-line claim
# protocol -- squeeze whitespace, trim, and cap the length.
notify_clean() {
  local text="$1" max="$2"
  text="$(printf '%s' "${text}" | tr '\000-\037\177' '   ' | tr -s ' ')"
  text="${text#"${text%%[![:space:]]*}"}"
  text="${text%"${text##*[![:space:]]}"}"
  printf '%s' "${text:0:${max}}"
}

# Minimal JSON string escaping for the no-jq fallback. Control characters are
# already gone by here, so backslash and double quote are the whole job.
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

do_notify() {
  local title="" level="info" body=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--title) shift; [[ $# -gt 0 ]] || die "--title requires a value"; title="$1" ;;
      -l|--level) shift; [[ $# -gt 0 ]] || die "--level requires a value"; level="$1" ;;
      -h|--help) usage; return 0 ;;
      -) body="${body}${body:+ }$(cat)" ;;
      --) shift; body="${body}${body:+ }$*"; break ;;
      -*) die "Unknown option: $1 (try: construct notify --help)" ;;
      *) body="${body}${body:+ }$1" ;;
    esac
    shift
  done

  case "${level}" in
    info) ;;
    warn|warning) level="warning" ;;
    err|error) level="error" ;;
    *) die "Unknown level: ${level} (use info, warning or error)" ;;
  esac

  body="$(notify_clean "${body}" "${NOTIFY_MAX_BODY}")"
  [[ -n "${body}" ]] || die "construct notify: nothing to say (pass a message, or '-' to read stdin)"
  title="$(notify_clean "${title:-$(hostname 2>/dev/null || echo VM)}" "${NOTIFY_MAX_TITLE}")"

  if [[ ! -d "${NOTIFY_SPOOL}" ]]; then
    # 1777 (like /tmp): any user on the VM may queue, nobody may clobber another's
    # entry. Creating /run/construct needs root, which is who agents run as here.
    install -d -m 1777 "${NOTIFY_SPOOL}" 2>/dev/null \
      || die "construct notify: cannot create ${NOTIFY_SPOOL} (create it once as root, or set NOTIFY_SPOOL)"
  fi

  local pending
  pending="$(find "${NOTIFY_SPOOL}" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l)"
  if (( pending >= NOTIFY_MAX_PENDING )); then
    printf 'construct notify: %s notifications already queued and undelivered (is VS Code open on the host?); dropping this one\n' \
      "${pending}" >&2
    return 5
  fi

  local ts source json tmp name
  ts="$(date +%s%3N 2>/dev/null || true)"
  [[ "${ts}" =~ ^[0-9]+$ ]] || ts="$(date +%s)000"
  source="$(notify_clean "${SUDO_USER:-$(id -un 2>/dev/null || echo agent)}@$(hostname -s 2>/dev/null || echo vm)" 60)"

  if command -v jq >/dev/null 2>&1; then
    json="$(jq -cn --argjson ts "${ts}" --arg level "${level}" --arg title "${title}" \
      --arg body "${body}" --arg source "${source}" \
      '{v:1,ts:$ts,level:$level,title:$title,body:$body,source:$source}')"
  else
    json="{\"v\":1,\"ts\":${ts},\"level\":\"$(json_escape "${level}")\",\"title\":\"$(json_escape "${title}")\",\"body\":\"$(json_escape "${body}")\",\"source\":\"$(json_escape "${source}")\"}"
  fi

  # Write, then publish with a rename: the host polls this directory and must never
  # read a half-written entry.
  name="${ts}-$$-${RANDOM}.json"
  tmp="${NOTIFY_SPOOL}/.tmp.$$.${RANDOM}"
  printf '%s\n' "${json}" >"${tmp}" || die "construct notify: cannot write to ${NOTIFY_SPOOL}"
  chmod 0644 "${tmp}" 2>/dev/null || true
  mv -f "${tmp}" "${NOTIFY_SPOOL}/${name}" || { rm -f "${tmp}"; die "construct notify: cannot publish to ${NOTIFY_SPOOL}"; }
  return 0
}

# -- argument parsing ----------------------------------------------------------

if [[ $# -lt 1 ]]; then usage >&2; exit 1; fi

case "$1" in
  project) shift ;;
  notify) shift; do_notify "$@"; exit $? ;;
  expose)
    shift
    expose_impl="$(find_helper construct-expose.sh)" \
      || die "construct-expose.sh not found (looked next to $0 and in ${CONSTRUCT_REPO_DIR}/bin)"
    exec bash "${expose_impl}" "$@"
    ;;
  vm)
    shift
    vm_impl="$(find_helper construct-vm.sh)" \
      || die "construct-vm.sh not found (looked next to $0 and in ${CONSTRUCT_REPO_DIR}/bin)"
    exec bash "${vm_impl}" "$@"
    ;;
  secret|secrets)
    shift
    secret_impl="$(find_helper construct-secret.sh)" \
      || die "construct-secret.sh not found (looked next to $0 and in ${CONSTRUCT_REPO_DIR}/bin)"
    exec bash "${secret_impl}" "$@"
    ;;
  backup|backups)
    shift
    backup_impl="$(find_helper construct-backup.sh)" \
      || die "construct-backup.sh not found (looked next to $0 and in ${CONSTRUCT_REPO_DIR}/bin)"
    exec bash "${backup_impl}" "$@"
    ;;
  config)
    shift
    config_impl="$(find_helper construct-config.sh)" \
      || die "construct-config.sh not found (looked next to $0 and in ${CONSTRUCT_REPO_DIR}/bin)"
    exec bash "${config_impl}" "$@"
    ;;
  update)
    shift
    update_impl="$(find_helper construct-update.sh)" \
      || die "construct-update.sh not found (looked next to $0 and in ${CONSTRUCT_REPO_DIR}/bin)"
    exec bash "${update_impl}" "$@"
    ;;
  systemprompt|system-prompt)
    # The renderer lives with the agent installers; source it function-only so
    # nothing else runs, then re-render root's (and TARGET_USER's) files.
    [[ "${EUID}" -eq 0 ]] || die "construct systemprompt: run as root (the instruction files belong to root)"
    installer="${CONSTRUCT_REPO_DIR}/bin/install-ai-tools.sh"
    [[ -f "${installer}" ]] || die "construct systemprompt: ${installer} not found"
    REPO_DIR="${CONSTRUCT_REPO_DIR}" CONSTRUCT_AI_TOOLS_FUNCS_ONLY=true \
      bash -c 'source "$1"; install_agent_system_prompts_all' _ "${installer}"
    exit $?
    ;;
  help|--help|-h) usage; exit 0 ;;
  *) die "Unknown command: $1 (try: construct project set|get|delete|list|conflicts|resolve, construct notify, construct update, construct systemprompt)" ;;
esac

if [[ $# -lt 1 ]]; then usage >&2; exit 1; fi

subcmd="$1"; shift

# With a host service, set and delete go through it (design 9.3): it merges the
# edit with what changed elsewhere and answers with the result. When it cannot be
# reached (exit 8) they fall back to the file and the deletion marker, which the
# host picks up from the folder later.
via_service() {
  local impl
  impl="$(find_helper construct-project.sh)" || return 8
  bash "${impl}" "$@"
}

service_configured() {
  local cfg="${CONFIG_FILE:-/etc/construct/config.env}"
  [[ -n "${CONSTRUCT_SERVICE_URL:-}" ]] && return 0
  [[ -f "${cfg}" ]] && grep -Eq "^CONSTRUCT_SERVICE_URL=.+" "${cfg}"
}

case "${subcmd}" in
  # ---------- set -------------------------------------------------------------
  set)
    if [[ $# -lt 1 ]]; then die "Usage: construct project set <name> [--file <path>]"; fi
    name="$1"; shift
    is_safe_name "${name}" || die "Invalid profile name: ${name} (must be a single filename, no path separators or '..')"

    # 'set' delegates to project-set.js which requires node for the shared
    # validateProfile / canonicalProfileJson from extension/src/projects.js.
    # With a host service the engine validates, so node is needed only to check
    # early and for the fallback.
    no_node() {
      printf '%s\n' "node is not installed on this VM." >&2
      printf '%s\n' "Edit the file directly: \${PROJECTS_STORE}/${name}.json" >&2
      printf '%s\n' "The host sync tick validates direct edits on the next cycle." >&2
      exit 4
    }
    have_node=true
    command -v node >/dev/null 2>&1 || have_node=false
    if [[ "${have_node}" == false ]] && ! service_configured; then no_node; fi

    # Locate project-set.js: next to this script in the repo checkout (works
    # both from /opt/construct/repo/bin and from a dev checkout).
    script_dir="$(cd "$(dirname "$0")" && pwd)"
    project_set="${script_dir}/project-set.js"
    if [[ ! -f "${project_set}" ]]; then
      # Fall back to the canonical repo location.
      project_set="${CONSTRUCT_REPO_DIR}/bin/project-set.js"
    fi
    if [[ ! -f "${project_set}" ]] && [[ "${have_node}" == true ]]; then
      die "project-set.js not found (looked in ${script_dir} and ${CONSTRUCT_REPO_DIR}/bin)"
    fi

    # Forward --file <path> or stdin to the node helper.
    args=("${name}")
    input=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --file) shift; [[ $# -gt 0 ]] || die "--file requires a path"; args+=("--file" "$1"); input="$1" ;;
        *) die "Unknown option: $1" ;;
      esac
      shift
    done

    if service_configured; then
      # Validate here first, then send; stdin is kept in a file for the fallback.
      if [[ -z "${input}" ]]; then
        input="$(mktemp)"; trap 'rm -f "${input}"' EXIT
        cat >"${input}"
        args+=("--file" "${input}")
      fi
      if [[ "${have_node}" == true ]]; then
        check_store="$(mktemp -d)"
        PROJECTS_STORE="${check_store}" node "${project_set}" "${args[@]}" >/dev/null || { rc=$?; rm -rf "${check_store}"; exit "${rc}"; }
        rm -rf "${check_store}"
      fi
      rc=0; via_service set "${name}" --file "${input}" || rc=$?
      [[ "${rc}" -eq 8 ]] || exit "${rc}"
      [[ "${have_node}" == true ]] || no_node
      printf 'The host service could not be reached; saving locally, the host picks it up later.\n' >&2
    fi

    rc=0; PROJECTS_STORE="${PROJECTS_STORE}" node "${project_set}" "${args[@]}" || rc=$?
    exit "${rc}"
    ;;

  # ---------- delete ----------------------------------------------------------
  delete)
    if [[ $# -ne 1 ]]; then die "Usage: construct project delete <name>"; fi
    name="$1"
    is_safe_name "${name}" || die "Invalid profile name: ${name} (must be a single filename, no path separators or '..')"
    case "$name" in
      [[:space:]]*|*[[:space:]]) die "Invalid profile name: leading or trailing whitespace" ;;
    esac
    case "${name,,}" in
      default|project.schema) printf '"%s" is a reserved name\n' "$name" >&2; exit 3 ;;
    esac
    if service_configured; then
      rc=0; via_service delete "${name}" || rc=$?
      [[ "${rc}" -eq 8 ]] || exit "${rc}"
      printf 'The host service could not be reached; marking the deletion for the host.\n' >&2
    fi
    file="${PROJECTS_STORE}/${name}.json"
    if [[ ! -f "$file" ]]; then printf 'Profile file was already absent: %s\n' "$name"; fi
    mkdir -p "${PROJECTS_STORE}/.deleted"
    touch "${PROJECTS_STORE}/.deleted/${name}"
    rm -f "$file"
    printf 'Deleted %s; the host removes its copy on its next sync.\n' "$name"
    ;;

  # ---------- get -------------------------------------------------------------
  get)
    if [[ $# -lt 1 ]]; then die "Usage: construct project get <name>"; fi
    name="$1"
    is_safe_name "${name}" || die "Invalid profile name: ${name} (must be a single filename, no path separators or '..')"
    file="${PROJECTS_STORE}/${name}.json"
    if [[ ! -f "${file}" ]]; then
      die "Profile not found: ${name}"
    fi
    cat "${file}"
    ;;

  # ---------- list ------------------------------------------------------------
  list)
    if [[ ! -d "${PROJECTS_STORE}" ]]; then exit 0; fi
    shopt -s nullglob
    for f in "${PROJECTS_STORE}"/*.json; do
      basename "${f}" .json
    done
    shopt -u nullglob
    ;;

  # ---------- conflicts / resolve (host service) -------------------------------
  conflicts)
    service_configured || die "construct project conflicts: this VM has no host service; profile conflicts are resolved on the host"
    rc=0; via_service conflicts "$@" || rc=$?
    exit "${rc}"
    ;;

  resolve)
    service_configured || die "construct project resolve: this VM has no host service"
    if [[ $# -lt 1 ]]; then die "Usage: construct project resolve <conflict-id> [--file <path>]"; fi
    id="$1"; shift
    input=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --file) shift; [[ $# -gt 0 ]] || die "--file requires a path"; input="$1" ;;
        *) die "Unknown option: $1" ;;
      esac
      shift
    done
    if [[ -z "${input}" ]]; then
      input="$(mktemp)"; trap 'rm -f "${input}"' EXIT
      cat >"${input}"
    fi
    rc=0; via_service resolve "${id}" --file "${input}" || rc=$?
    exit "${rc}"
    ;;

  *)
    die "Unknown subcommand: ${subcmd} (try: set, get, delete, list, conflicts, resolve)"
    ;;
esac

+
+  it("drops carried-over compare results once the installed commit changed", async () => {
+    const previous: ConstructUpdateInfo = {
+      repo: "permissionBRICK/The-Construct",
+      ref: "main",
+      scriptsDir: SCRIPTS_DIR,
+      vmName: "agent-vm",

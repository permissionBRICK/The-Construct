+ *  - `reprovision`: run Update-T3Code.ps1, which reprovisions the VM with the
+ *    installed Construct and rebuilds/installs the patched T3 Code.
+ */
+export type ConstructUpdateAction = "update-construct" | "reprovision";
+export const ConstructUpdateActionSchema = Schema.Literals(["update-construct", "reprovision"]);
+
+/**
+ * Construct-managed update tracking, present only in Construct-built Desktop
+ * apps (`<t3 version>-construct.<hash>`). The Desktop main process reads the
+ * Construct install markers on this PC (`.construct-settings.json`), compares
+ * the installed Construct commit with its GitHub ref, the VM's provisioned
+ * commit with the installed one, and this build's T3 base version with the
+ * npm channel. Mirrors the VS Code control panel's update banner + yellow
+ * Reprovision button.
+ */
+export interface ConstructUpdateInfo {
+  /** GitHub `owner/repo` the installed Construct tracks. */
+  repo: string;
+  /** Branch/ref the installed Construct tracks. */
+  ref: string;
+  /** Where the Construct scripts were found on this PC; null when not found. */
+  scriptsDir: string | null;
+  /** The VM a reprovision targets: the registry's default instance (`agent-vm` when
+   *  there is no registry) and its SSH host. */
+  vmName: string;
+  vmHost: string;
+  /** Installed Construct commit (scripts + VS Code panel); null when unknown. */
+  installedCommit: string | null;
+  /** Commit the VM was last provisioned with; null when unknown. */
+  provisionedCommit: string | null;
+  /** Commits the installed Construct is behind its ref; null when unknown. */
+  behind: number | null;
+  /** A newer Construct commit exists on the tracked ref. */
+  constructUpdateAvailable: boolean;
+  /** The VM was provisioned with a different Construct than the one installed here. */
+  provisionStale: boolean;
+  /** This build's upstream T3 Code version (the `-construct.<hash>` suffix stripped). */
+  t3Version: string;
+  /** Newest upstream T3 Code release on this build's channel; null when unknown. */
+  t3LatestVersion: string | null;
+  /** A newer upstream T3 Code release exists on this build's channel. */
+  t3UpdateAvailable: boolean;
+  /** What the update control does now; null when everything is current. */
+  action: ConstructUpdateAction | null;
+  /** A launched host script is still running; the control is inert meanwhile. */
+  runningAction: ConstructUpdateAction | null;
+  /** Last successful or failed check, ISO timestamp. */

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The real engine (constructd in fake mode) on a loopback HTTPS port for the UI's end-to-end test, with a
       scripted guest so a provision job can run to its end. Built and started by tests/e2e/agent.spec.ts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Construct.Ui.EngineHost</RootNamespace>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\service\src\Constructd.Api\Constructd.Api.csproj" />
  </ItemGroup>

</Project>

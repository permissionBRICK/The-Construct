{
  "name": "construct-control-panel",
  "displayName": "The Construct",
  "description": "The Construct agent's window in VS Code, and opening your Construct VMs over Remote-SSH.",
  "version": "1.0.0",
  "publisher": "permissionbrick",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "construct",
          "title": "The Construct",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "construct": [
        {
          "id": "construct.panel",
          "name": "The Construct",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "construct.openPanel",
        "title": "Open the Construct Window",
        "category": "The Construct"
      },
      {
        "command": "construct.openHostAdmin",
        "title": "Host Administration",
        "category": "The Construct"
      },
      {
        "command": "construct.newRemoteVm",
        "title": "New VM",
        "category": "The Construct"
      },
      {
        "command": "construct.openVm",
        "title": "Open a VM in VS Code",
        "category": "The Construct"
      },
      {
        "command": "construct.registerWorkspace",
        "title": "Register This Folder as a Project",
        "category": "The Construct"
      }
    ]
  }
}

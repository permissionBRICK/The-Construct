AGENT_NAME=agent-vm-01
PROJECTS=default
AGENT_HOME=/opt/construct
WORKSPACE_ROOT=/root/repos
SSH_USER=agent
ALLOW_HOST_PACKAGES=false
AI_TOOLS=opencode,claude-code,codex
OPENCODE_HOST=0.0.0.0
OPENCODE_PORT=4096
CODEX_HOST=0.0.0.0
CODEX_PORT=4500
CODEX_TOKEN_FILE=/etc/construct/codex-app-server.token

# T3CODE: opt-in web GUI (the `t3` npm package -- pingdotgg's T3 Code) that
# drives the installed coding agents from a browser. Off by default; when true,
# provisioning installs the CLI and autostarts the t3code-serve service bound to
# T3CODE_HOST:T3CODE_PORT. Access is pairing-token gated: mint a login link with
#   t3 auth pairing create --base-url http://<vm-dns>:<port>
# (the control panel's "open web UI" button does this for you).
T3CODE=false
T3CODE_HOST=0.0.0.0
T3CODE_PORT=5177
# Install channel: "stable" tracks npm @latest (the released version); "nightly"
# tracks npm @nightly (the latest CI build — newer features, may break).
T3CODE_CHANNEL=stable
# Optional shared source build for the VM server + Windows Desktop installer;
# includes voice input and Construct's other T3 integrations.
T3CODE_LIMIT_RESUME=false

# VSCODE_SERVER: always install the VS Code CLI ("VS Code Server") so VS Code
# Remote-SSH works out of the box (set false to skip).
# VSCODE_SERVE_WEB: autostart `code serve-web` -- browser-based VS Code over HTTP,
# gated by a connection token (no account sign-in). Bound to
# VSCODE_SERVE_WEB_HOST:VSCODE_SERVE_WEB_PORT; reachable at
# http://<host>:<port>/?tkn=<token>. The token is generated into
# VSCODE_SERVE_WEB_TOKEN_FILE.
# VSCODE_TUNNEL: opt in to also autostart a `code tunnel`, reachable from
# vscode.dev with no inbound port. First-time setup needs a one-time browser
# sign-in (the provisioner pauses for it). Once registered, re-provisions keep
# the tunnel autostarting even with this set back to false.
# VSCODE_TUNNEL_NAME: the vscode.dev/tunnel/<name> identifier; blank = derived
# from the hostname.
VSCODE_SERVER=true
VSCODE_SERVE_WEB=true
VSCODE_SERVE_WEB_HOST=0.0.0.0
VSCODE_SERVE_WEB_PORT=8000
VSCODE_SERVE_WEB_TOKEN_FILE=/etc/construct/vscode-serve-web.token
VSCODE_TUNNEL=false
VSCODE_TUNNEL_NAME=

# SMB_SHARE: on by default -- provisioning runs a Samba server that exposes the
# workspace (WORKSPACE_ROOT) to the host PC, and the host-side provisioner
# auto-mounts it (net use Z: \\<vm>\<share> /user:<SMB_USER> <pw> /savecred
# /persistent:yes). The host authenticates as SMB_USER, but all file access on
# the share runs as root (force user = root) -- so the host edits the repos as
# the same user as the agents.
# SMB_USER / SMB_SHARE_NAME: the SMB login name and the share name in the UNC
# path (\\<vm>\<SMB_SHARE_NAME>).
# SMB_PASSWORD: generated once on the first provision and persisted here, so a
# re-provision reuses the same login the host already saved. Clear it (or set a
# new value) to rotate the password on the next provision.
SMB_SHARE=true
SMB_USER=dev
SMB_SHARE_NAME=repo
SMB_PASSWORD=

# CONSTRUCT_EXTERNAL_HOST: the hostname (or IP) that clients use to reach this
# VM from outside. Empty (the default) means "auto: <hostname>.mshome.net", which
# is the Hyper-V local DNS name published on the .mshome.net subnet. Set this when
# the VM is reached via a different address (e.g. a port-forwarded external host,
# a custom DNS name, or a non-Hyper-V hypervisor). Guest scripts (banner, SMB UNC,
# agent system prompt) and setup-root-ssh-key.sh use this value. Empty string means
# "keep the VM's saved choice" across a reprovision.
CONSTRUCT_EXTERNAL_HOST=

# CONSTRUCT_EXTERNAL_SSH_PORT: the TCP port clients use to reach SSH on this VM.
# Default is 22 (standard SSH). Set this when SSH is exposed on a non-standard port
# (e.g. via NAT/port-forwarding). SSH-shaped outputs in the login banner and the
# root SSH key config snippet include "Port <n>" / "-p <n>" when this differs from
# 22. HTTP service URLs are unaffected (they keep their own service ports).
# Empty string means "keep the VM's saved choice" across a reprovision.
CONSTRUCT_EXTERNAL_SSH_PORT=22

# CONSTRUCT_SERVICE_URL: base URL of the Construct host service (constructd) that
# manages this VM, e.g. https://buildbox.example.local:7462. EMPTY (the default,
# and every local Hyper-V install) means "there is no service": `construct expose`
# then queues its forward requests in the guest spool /etc/construct/forwards for
# the VS Code extension to pick up, and no activity-heartbeat timer is installed.
# Empty string means "keep the VM's saved choice" across a reprovision.
CONSTRUCT_SERVICE_URL=
# CONSTRUCT_INSTANCE_NAME: this VM's instance name on that service -- the {name}
# in /api/v1/vms/{name}/... Empty = the lowercased hostname.
CONSTRUCT_INSTANCE_NAME=
# CONSTRUCT_EXPOSE_DEFAULT_TARGET: where `construct expose <port>` sends a forward
# when --to is not given. "client" (the default) opens the port on the USER'S PC
# over the existing SSH connection and is what agents should hand to the user;
# "host" publishes it on the VM host's LAN address instead (webhooks, teammates).
CONSTRUCT_EXPOSE_DEFAULT_TARGET=client
# CONSTRUCT_EXPOSE_WAIT_SEC: how long `construct expose` waits for a client
# forward to actually come up before reporting it as queued (exit code 6).
CONSTRUCT_EXPOSE_WAIT_SEC=30
# CONSTRUCT_SERVICE_CA_FILE: PEM certificate used to verify the host service
# (curl --cacert) -- set this to pin the self-signed certificate the service
# generates at install time. Empty = the system trust store.
CONSTRUCT_SERVICE_CA_FILE=
# CONSTRUCT_IDLE_REPORT_INTERVAL_SEC: how often the guest activity heartbeat
# reports to the host service (systemd timer construct-idle-report.timer, enabled
# only when CONSTRUCT_SERVICE_URL is set). The service saves an idle VM only when
# BOTH its forwards and this heartbeat are quiet, so a long unattended agent job
# keeps the VM alive. Valid range 5-3600 seconds; anything else (notably 0, which
# systemd reads as a DISABLED timer) falls back to 60. See docs/expose.md.
CONSTRUCT_IDLE_REPORT_INTERVAL_SEC=60

# The template ships with a minimal local runtime in agent-runtime/.
# Replace this with a registry image once the construct image exists.
AGENT_IMAGE=construct-local:latest

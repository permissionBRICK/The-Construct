<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Constructd.Core deliberately has ZERO package references: domain records, interfaces and
    pure logic only. No ASP.NET Core, no hosting, no persistence. Everything platform- or
    transport-specific lives behind the interfaces in Abstractions/.
  -->

  <ItemGroup>
    <EmbeddedResource Include="Logic/WindowsGuestReport.ps1" LogicalName="WindowsGuestReport.ps1" />
    <EmbeddedResource Include="../../../examples/winvm-blank/vm/unattend-win11/*" LogicalName="WindowsClient.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../examples/winvm-blank/vm/unattend/*" LogicalName="WindowsServer.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

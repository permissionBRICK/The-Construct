<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Constructd.Api</RootNamespace>
    <!-- The tests drive the host through WebApplicationFactory<Program>. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Constructd.Core\Constructd.Core.csproj" />
    <!--
      The fakes ship with the host on purpose: fake mode (Constructd:Fake=true) runs the whole API
      without Hyper-V, which is how it is developed and tested off Windows.
    -->
    <ProjectReference Include="..\Constructd.Fakes\Constructd.Fakes.csproj" />
    <!-- The durable stores; cross-platform, so they are used in every non-fake mode. -->
    <ProjectReference Include="..\Constructd.Sqlite\Constructd.Sqlite.csproj" />
    <ProjectReference Include="..\Constructd.Windows\Constructd.Windows.csproj" />
    <!-- The Proxmox VE platform (Constructd:Backend=proxmox); selected at composition time. -->
    <ProjectReference Include="..\Constructd.Proxmox\Constructd.Proxmox.csproj" />
    <!-- The record store, mounted under /api/v1/store (Composition/RecordStoreComposition.cs). -->
    <ProjectReference Include="..\Constructd.Store\Constructd.Store.csproj" />
    <!-- Devices, grants and the engine side of sync (Composition/RecordStoreComposition.cs). -->
    <ProjectReference Include="..\Constructd.Sync\Constructd.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The key vault's phone pages, served anonymously at /vault/ (Endpoints/VaultWebEndpoints.cs). -->
    <EmbeddedResource Include="VaultWeb/*" LogicalName="VaultWeb.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <!--
      The Hyper-V driver's own PowerShell (Constructd.Windows/HyperV/HyperVScripts.cs), copied to
      hyperv\ next to the service and dot-sourced from there, so the service needs no Construct
      checkout. Here rather than in Constructd.Windows: only the executable's project knows the
      runtime, and a Linux (Proxmox) publish leaves these out.
    -->
    <None Include="../Constructd.Windows/HyperV/Scripts/*.ps1" Link="hyperv/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!--
      What adopting a VM the old client made writes into the guest (Jobs/LocalVmAdoption.cs): the
      enrollment script and the helpers it installs, copied to guest\ next to the service.
    -->
    <None Include="../../../bin/adopt-host.py;../../../bin/construct;../../../bin/construct-vm.sh;../../../bin/construct-expose.sh;../../../bin/construct-secret.sh;../../../bin/construct-config.sh;../../../bin/construct-idle-report.sh;../../../bin/construct-backup.sh"
          Link="guest/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kerberos/NTLM; registered only when running on Windows (see Auth/AuthenticationSetup.cs). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Windows service hosting hook; a no-op elsewhere. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

</Project>

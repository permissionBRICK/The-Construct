[Unit]
Description=OpenCode HTTP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/construct/config.env
WorkingDirectory=/root/repos
ExecStart=/usr/local/bin/opencode serve --hostname ${OPENCODE_HOST} --port ${OPENCODE_PORT}
Restart=always
RestartSec=5
# One OOM-killed child (a build, a browser) must not take the whole unit and every
# agent session in it down; systemd's default OOMPolicy=stop does exactly that.
# Which process the kernel picks first is construct-oom-guard's job.
OOMPolicy=continue
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target

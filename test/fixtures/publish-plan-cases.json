{
  "description": "Shared behaviour fixture for the publish planner (plan 4.13 / B15). extension/src/configsync.js planPublish and lib/AgentVm.Common.ps1 Get-ConstructPublishPlan must produce the SAME buckets for every case; each engine's test suite iterates this file. Names in the expected buckets are sorted. reasonContains / reasonExcludes assert display safety (no URL credentials) and the wording users act on.",
  "cases": [
    {
      "name": "an untracked profile with no upstream copy is published",
      "profiles": [
        {
          "name": "alpha",
          "raw": "{\"name\":\"alpha\",\"repos\":[],\"sdks\":{},\"mcp\":[],\"hostPackages\":[],\"provisionCommands\":[],\"tests\":{}}"
        }
      ],
      "manifest": {},
      "remoteFiles": {},
      "selected": null,
      "expect": {
        "publish": [
          {
            "name": "alpha",
            "adopt": false
          }
        ],
        "skipTracked": [],
        "refuse": [],
        "invalid": []
      }
    },
    {
      "name": "a tracked profile is skipped and its reason never carries the PAT",
      "profiles": [
        {
          "name": "beta",
          "raw": "{\"name\":\"beta\",\"repos\":[],\"sdks\":{},\"mcp\":[],\"hostPackages\":[],\"provisionCommands\":[],\"tests\":{}}"
        }
      ],
      "manifest": {
        "beta": {
          "remoteUrl": "https://alice:glpat-secret-token@git.example.com/alice/cfg.git"
        }
      },
      "remoteFiles": {},
      "selected": null,
      "expect": {
        "publish": [],
        "skipTracked": [
          "beta"
        ],
        "refuse": [],
        "invalid": [],
        "reasonContains": {
          "beta": [
            "Push back",
            "***",
            "git.example.com"
          ]
        },
        "reasonExcludes": {
          "beta": [
            "glpat-secret-token",
            "alice:"
          ]
        }
      }
    },
    {
      "name": "a differing upstream file of the same name is refused",
      "profiles": [
        {
          "name": "gamma",
          "raw": "{\"name\":\"gamma\",\"repos\":[],\"sdks\":{},\"mcp\":[],\"hostPackages\":[\"ours\"],\"provisionCommands\":[],\"tests\":{}}"
        }
      ],
      "manifest": {},
      "remoteFiles": {
        "gamma": "{\"name\":\"gamma\",\"repos\":[],\"sdks\":{},\"mcp\":[],\"hostPackages\":[\"theirs\"],\"provisionCommands\":[],\"tests\":{}}"
      },
      "selected": null,
      "expect": {
        "publish": [],
        "skipTracked": [],
        "refuse": [
          "gamma"
        ],
        "invalid": [],
        "reasonContains": {
          "gamma": [
            "import it first"
          ]
        }
      }
    },
    {
      "name": "a byte-identical upstream copy is adopted, not refused",
      "profiles": [
        {
          "name": "delta",
          "raw": "{\"name\":\"delta\",\"repos\":[],\"sdks\":{},\"mcp\":[],\"hostPackages\":[],\"provisionCommands\":[],\"tests\":{}}"
        }
      ],
      "manifest": {},
      "remoteFiles": {
        "delta": "{\"name\":\"delta\",\"repos\":[],\"sdks\":{},\"mcp\":[],\"hostPackages\":[],\"provisionCommands\":[],\"tests\":{}}"

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>Construct.Agent.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Construct.Agent.Core\Construct.Agent.Core.csproj" />
    <!-- For the repair test, which starts the real executable; aliased, so its Program does not meet the engine's. -->
    <ProjectReference Include="..\..\src\construct-agent\construct-agent.csproj" Aliases="cli" />
    <!-- The real engine, in fake mode, on a loopback HTTPS port. -->
    <ProjectReference Include="..\..\..\service\src\Constructd.Api\Constructd.Api.csproj" />
    <!-- The Companion's fakes for the parts ported from it (SSH transport, toasts, audio). -->
    <ProjectReference Include="..\..\..\companion\src\Construct.Companion.Fakes\Construct.Companion.Fakes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

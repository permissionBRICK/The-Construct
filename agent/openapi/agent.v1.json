{
  "openapi": "3.1.1",
  "info": {
    "title": "construct-agent",
    "description": "The device agent's local API on loopback (http://127.0.0.1:<port>, both in the token file). Every route but GET /api/health takes `Authorization: Bearer <token>`. Engine calls go through the proxy `/api/engines/{id}/api/v1/...`, which forwards to that engine's `/api/v1/...` (its own contract, service/openapi/constructd.v1.json) over the pinned connection with this device's credential. Every error answer is an AgentProblem.",
    "version": "v1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "agent"
        ],
        "description": "Answers without the token: the repair command and the shell ask whether the agent runs.",
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentHealth"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/state": {
      "get": {
        "tags": [
          "agent"
        ],
        "operationId": "GetState",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentStateView"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/shutdown": {
      "post": {
        "tags": [
          "agent"
        ],
        "operationId": "Shutdown",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "tags": [
          "agent"
        ],
        "description": "Server-sent events: `agent`, `pairing`, `job.progress`, `job.phase`, `job.state`, `job.lost`; `reset` when the events after `since` are gone. Each `data` is an AgentEvent.",
        "operationId": "Events",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/engines": {
      "get": {
        "tags": [
          "agent"
        ],
        "operationId": "ListEngines",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EngineView"
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "agent"
        ],
        "operationId": "AddEngine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddEngineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineView"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/engines/probe": {
      "post": {
        "tags": [
          "agent"
        ],
        "description": "Connects to a pasted address without any credential and returns the certificate pin for the user to confirm.",
        "operationId": "ProbeEngine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProbeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineProbe"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/engines/local": {
      "get": {
        "tags": [
          "agent"
        ],
        "description": "The solo engine on this machine on loopback; 204 when none answers.",
        "operationId": "ProbeLocalEngine",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineProbe"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/engines/{id}": {
      "delete": {
        "tags": [
          "agent"
        ],
        "operationId": "RemoveEngine",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/engines/{id}/connect": {
      "post": {
        "tags": [
          "agent"
        ],
        "description": "Grants the engine D (and K when vaultMode is available) and enrols this device there.",
        "operationId": "ConnectEngine",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectEngineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineView"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/device/setup": {
      "post": {
        "tags": [
          "agent"
        ],
        "description": "The account's first device, against the engine's built-in store. The answer carries the recovery code, the only time it is shown.",
        "operationId": "SetUpFirstDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodeResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/device/recovery-code": {
      "post": {
        "tags": [
          "agent"
        ],
        "operationId": "NewRecoveryCode",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryCodeResponse"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/device/recover": {
      "post": {
        "tags": [
          "agent"
        ],
        "operationId": "Recover",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceView"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/pairing": {
      "post": {
        "tags": [
          "agent"
        ],
        "description": "This device asks to join an account; the agent waits for the approval by itself and reports on /api/events.",
        "operationId": "StartPairing",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartPairingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingView"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "agent"
        ],
        "operationId": "GetPairing",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "agent"
        ],
        "operationId": "CancelPairing",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/pairing/requests/{id}": {
      "get": {
        "tags": [
          "agent"
        ],
        "operationId": "GetPairingRequest",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingRequestView"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/pairing/requests/{id}/approve": {
      "post": {
        "tags": [
          "agent"
        ],
        "description": "publicKey is the one GetPairingRequest returned with the words the user compared.",
        "operationId": "ApprovePairing",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovePairingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "tags": [
          "agent"
        ],
        "operationId": "ListDevices",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceListItem"
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{id}": {
      "delete": {
        "tags": [
          "agent"
        ],
        "operationId": "RevokeDevice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevocationView"
                }
              }
            }
          },
          "default": {
            "description": "An error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddEngineRequest": {
        "required": [
          "address",
          "pin"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "userToken": {
            "type": [
              "null",
              "string"
            ],
            "x-construct-secret": true
          }
        }
      },
      "AgentHealth": {
        "required": [
          "status",
          "version",
          "pid",
          "startedAt"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "pid": {
            "type": "integer",
            "format": "int32"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AgentProblem": {
        "required": [
          "title",
          "status",
          "code"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "AgentStateView": {
        "required": [
          "device",
          "engines",
          "pairing"
        ],
        "type": "object",
        "properties": {
          "device": {
            "$ref": "#/components/schemas/DeviceView"
          },
          "engines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EngineView"
            }
          },
          "pairing": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PairingView"
              }
            ]
          }
        }
      },
      "ApprovePairingRequest": {
        "required": [
          "publicKey"
        ],
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string"
          }
        }
      },
      "ConnectEngineRequest": {
        "type": "object",
        "properties": {
          "vaultMode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DeviceListItem": {
        "required": [
          "id",
          "name",
          "me",
          "revoked",
          "added",
          "acknowledgedBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "me": {
            "type": "boolean"
          },
          "revoked": {
            "type": "boolean"
          },
          "added": {
            "type": "string",
            "format": "date-time"
          },
          "acknowledgedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeviceView": {
        "required": [
          "id",
          "name",
          "account",
          "registered",
          "storeEngine",
          "protection",
          "protectionWeak"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "account": {
            "type": [
              "null",
              "string"
            ]
          },
          "registered": {
            "type": "boolean"
          },
          "storeEngine": {
            "type": [
              "null",
              "string"
            ]
          },
          "protection": {
            "type": "string"
          },
          "protectionWeak": {
            "type": "boolean"
          }
        }
      },
      "EngineProbe": {
        "required": [
          "url",
          "pin",
          "status",
          "known"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          },
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "known": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EngineView": {
        "required": [
          "id",
          "name",
          "url",
          "pin",
          "engineId",
          "enrolled",
          "signedIn",
          "store"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pin": {
            "type": "string"
          },
          "engineId": {
            "type": [
              "null",
              "string"
            ]
          },
          "enrolled": {
            "type": "boolean"
          },
          "signedIn": {
            "type": "boolean"
          },
          "store": {
            "type": "boolean"
          }
        }
      },
      "PairingRequestView": {
        "required": [
          "pairingId",
          "name",
          "words",
          "publicKey",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "pairingId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "publicKey": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PairingView": {
        "required": [
          "pairingId",
          "state",
          "words",
          "expiresAt",
          "storeUrl",
          "storePin",
          "problem"
        ],
        "type": "object",
        "properties": {
          "pairingId": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "storeUrl": {
            "type": "string"
          },
          "storePin": {
            "type": "string"
          },
          "problem": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProbeRequest": {
        "required": [
          "address"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "RecoverRequest": {
        "required": [
          "engine",
          "account",
          "recoveryCode",
          "deviceName"
        ],
        "type": "object",
        "properties": {
          "engine": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "recoveryCode": {
            "type": "string",
            "x-construct-secret": true
          },
          "deviceName": {
            "type": "string"
          }
        }
      },
      "RecoveryCodeResponse": {
        "required": [
          "recoveryCode"
        ],
        "type": "object",
        "properties": {
          "recoveryCode": {
            "type": "string",
            "x-construct-secret": true
          }
        }
      },
      "RevocationEngine": {
        "required": [
          "id",
          "name",
          "confirmed"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        }
      },
      "RevocationView": {
        "required": [
          "deviceId",
          "engines"
        ],
        "type": "object",
        "properties": {
          "deviceId": {

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console host on Linux: `construct-agent [run|open|repair]` as a user process. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>construct-agent</AssemblyName>
    <RootNamespace>Construct.Agent.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Construct.Agent.Core\Construct.Agent.Core.csproj" />
  </ItemGroup>

</Project>

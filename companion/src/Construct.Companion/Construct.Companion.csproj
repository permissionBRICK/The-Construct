<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ConstructCompanion</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Construct.Companion.Core/Construct.Companion.Core.csproj" />
    <ProjectReference Include="../Construct.Companion.Host/Construct.Companion.Host.csproj" />
    <ProjectReference Include="../Construct.Companion.Windows/Construct.Companion.Windows.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <Content Include="../../../extension/media/**" Link="media/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WebView2 also adds a WPF reference even though this is a WinForms app. -->
  <Target Name="RemoveWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
